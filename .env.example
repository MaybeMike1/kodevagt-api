# Server
PORT=3000
HOST=0.0.0.0
REQUEST_LOG=true

# GitHub OAuth (optional for desktop token auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_VERIFIER_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector store (memory | lance)
VECTOR_STORE=lance
VECTOR_STORE_PATH=./data/vector
EMBEDDING_DIMENSIONS=768

# Review tuning
REVIEW_ASYNC=true
REVIEW_FAST_MODE=true
REVIEW_MIN_CONFIDENCE=0.65
REVIEW_TARGET_CONFIDENCE=0.8
REVIEW_QUALITY_FALLBACK=true
REVIEW_JOB_POLL_MS=1500
REVIEW_JOB_MAX_WAIT_MS=240000

# CORS (comma-separated; Tauri dev defaults included if unset)
# CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
